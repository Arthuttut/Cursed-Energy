[{"namespace":"palladium","path":"empty","name":"Empty","description":"Empty background. Renders nothing","fields":[]},{"namespace":"palladium","path":"texture","name":"Texture","description":"Renders a static texture as a background.","fields":[{"key":"texture","type":"Identifier","description":"Texture path.","required":true,"fallback":null},{"key":"width","type":"Integer (>= 0)","description":"Width of the texture file.","required":false,"fallback":256},{"key":"height","type":"Integer (>= 0)","description":"Height of the texture file.","required":false,"fallback":256}]},{"namespace":"palladium","path":"repeating_texture","name":"Repeating Texture","description":"Repeating a texture so often that it fills the background.","fields":[{"key":"texture","type":"Identifier","description":"Texture path.","required":true,"fallback":null},{"key":"width","type":"Integer (>= 0)","description":"Width of the texture file.","required":false,"fallback":256},{"key":"height","type":"Integer (>= 0)","description":"Height of the texture file.","required":false,"fallback":256}]},{"namespace":"palladium","path":"sprite","name":"Sprite","description":"Renders a sprite accordingly to fill the background.","fields":[{"key":"sprite","type":"Identifier","description":"Sprite ID.","required":true,"fallback":null}]}]