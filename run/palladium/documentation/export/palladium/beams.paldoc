[{"namespace":"palladium","path":"laser","name":"Laser","description":"Renders a laser beam between two points.","fields":[{"key":"render_settings","type":"Laser Renderer Settings","description":"The render settings for the laser.","required":true,"fallback":null}],"examples":[{"type":"palladium:laser","render_settings":{"glow":"#0000ff","size":2.0}}]},{"namespace":"palladium","path":"lightning","name":"Lightning Beam","description":"Renders a fluctuating lightning between two points.","fields":[{"key":"render_settings","type":"Laser Renderer Settings","description":"The render settings for the lightning.","required":true,"fallback":null},{"key":"segments","type":"Integer","description":"The amount of segments the lightning should have.","required":false,"fallback":5},{"key":"frequency","type":"Integer","description":"The frequency of the lightning fluctuation.","required":false,"fallback":2},{"key":"spread","type":"Float","description":"The spread of the lightning fluctuation. It defines how \"far\" the lightning can spread out from the core","required":false,"fallback":5.0}],"examples":[{"type":"palladium:lightning","render_settings":{"glow":"#0000ff","bloom":2,"size":2.0},"segments":10,"frequency":4,"spread":112.0}]},{"namespace":"palladium","path":"textured","name":"Textured","description":"Renders a beam between two points using a custom texture.","fields":[{"key":"texture","type":"Texture Reference","description":"The texture to use for the beam.","required":true,"fallback":null},{"key":"size","type":"Float","description":"The size/diameter of the beam.","required":false,"fallback":1.0},{"key":"rotation","type":"Float","description":"The initial rotation of the beam in degrees.","required":false,"fallback":0.0},{"key":"rotation_speed","type":"Float","description":"The rotation speed of the beam.","required":false,"fallback":0.0},{"key":"render_type","type":{"type":"enum","values":["minecraft:entity_translucent","minecraft:entity_cutout"]},"description":"The render type to render the beam with.","required":false,"fallback":"minecraft:entity_translucent"},{"key":"light_emission","type":"Integer","description":"The light emission of the beam. Must be within 0 - 15","required":false,"fallback":0}],"examples":[{"type":"palladium:textured","texture":"namespace:textures/beams/example_beam.png","size":2.0,"rotation":45.0,"rotation_speed":20.0}]}]