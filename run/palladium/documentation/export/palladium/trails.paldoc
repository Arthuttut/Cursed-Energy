[{"namespace":"palladium","path":"after_image","name":"After Image Trail","description":"Renders copies of the entity behind it.","fields":[{"key":"color","type":"Color","description":"Defines the color/tint of the after image","required":false,"fallback":"#ffffff"},{"key":"opacity","type":"Float","description":"Starting opacity of the after image","required":false,"fallback":0.5}],"examples":[{"type":"palladium:after_image","color":"#ff0000","opacity":0.2}]},{"namespace":"palladium","path":"gradient","name":"Gradient Trail","description":"Renders a colored gradient behind the players.","fields":[{"key":"color","type":"Color","description":"Defines the color of the gradient","required":false,"fallback":"#ffffff"},{"key":"opacity","type":"Float","description":"Starting opacity of the gradient","required":false,"fallback":0.5},{"key":"orientation","type":{"type":"enum","values":["horizontal","vertical"]},"description":"Defines the orientation in relation to the entity in which the gradient will render","required":false,"fallback":"VERTICAL"},{"key":"offset","type":"Float","description":"Defines where the gradient will start in relation to entity hitbox. 0.5 is equal to the center.","required":false,"fallback":0.5}],"examples":[{"type":"palladium:gradient","color":"#ff0000","opacity":0.7,"orientation":"horizontal","offset":0.2}]},{"namespace":"palladium","path":"lightning","name":"Lightning Trail","description":"Renders lightning behind the entity.","fields":[{"key":"amount","type":"Integer","description":"Defines how many lightnings will follow the player","required":false,"fallback":10},{"key":"render_settings","type":"Laser Renderer Settings","description":"The render settings for the lightning.","required":true,"fallback":null}],"examples":[{"type":"palladium:lightning","amount":7,"render_settings":{"glow":"#0000ff","size":2.0}}]}]