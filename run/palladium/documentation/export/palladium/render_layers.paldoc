[{"namespace":"palladium","path":"render_layer","name":"Default Render Layer","description":"Default render layer that renders a model with a texture.","fields":[{"key":"model_layer","type":"Identifier","description":"The model layer to render.","required":false,"fallback":"If not present, the model of the parent entity will be used."},{"key":"texture","type":{"type":"combined","options":["Identifier","Dynamic Texture","Texture Reference"]},"description":"The texture to render the model with.","required":true,"fallback":null},{"key":"render_type","type":{"type":"enum","values":["minecraft:entity_translucent","minecraft:entity_cutout"]},"description":"The render type to render the model with.","required":false,"fallback":"minecraft:entity_translucent"},{"key":"light_emission","type":"Integer","description":"The light emission of the model. Must be within 0 - 15","required":false,"fallback":0}],"examples":[{"type":"palladium:render_layer","model_layer":{"wide":"example:wide_model","slim":"example:slim_model"},"texture":{"wide":"example:wide_texture","slim":"example:slim_texture"},"light_emission":5}]},{"namespace":"palladium","path":"compound","name":"Compound Render Layer","description":"A compound render layer that can contain multiple render layers.","fields":[{"key":"layers","type":"Render Layers","description":"The list of render layers this compound render layer contains.","required":true,"fallback":null}]},{"namespace":"palladium","path":"lightning_sparks","name":"Lightning Sparks","description":"Renders lightning sparks around the entity.","fields":[{"key":"frequency","type":"Float","description":"The frequency of the sparks.","required":false,"fallback":0.5},{"key":"amount","type":"Integer","description":"The amount of sparks to spawn during each occurence.","required":false,"fallback":5},{"key":"render_settings","type":"Laser Renderer Settings","description":"The render settings for the sparks.","required":true,"fallback":null}],"examples":[{"type":"palladium:lightning_sparks","frequency":0.2,"amount":10,"render_settings":{"glow":"#0000ff","bloom":2,"size":2.0}}]},{"namespace":"palladium","path":"block_on_head","name":"Block on Head","description":"Renders a block on the top of the entity's head.","fields":[{"key":"block","type":"Block Tag","description":"ID of the block/block state definition","required":true,"fallback":null}],"examples":[{"type":"palladium:block_on_head","block":{"Name":"minecraft:glass"}}]},{"namespace":"palladium","path":"vibration","name":"Vibration","description":"Renders a vibration effect on the entity.","fields":[{"key":"intensity","type":"Integer","description":"The intensity of the vibration.","required":true,"fallback":null},{"key":"fade_ticks","type":{"type":"combined","options":["Integer","Time String (\"40s\", \"2m\", etc.)"]},"description":"The time/ticks it needs for the vibration to fade in/out.","required":true,"fallback":null}],"examples":[{"type":"palladium:vibration","intensity":10}]}]