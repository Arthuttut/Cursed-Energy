[{"namespace":"palladium","path":"static","name":"Static Texture","description":"Simple, static texture that does not change.","fields":[{"key":"texture","type":"Identifier","description":"The texture to use.","required":true,"fallback":null}],"examples":[{"texture":"example:textures/example.png"}]},{"namespace":"palladium","path":"configured","name":"Configured Texture","description":"Creates a dynamic texture based on variables and transformers.","fields":[{"key":"base","type":"Identifier","description":"Base texture","required":true,"fallback":null},{"key":"variables","type":"Map<String, Path Variable>","description":"A map of variables that can be used in the texture path.","required":false,"fallback":null},{"key":"transformers","type":{"type":"combined","options":["Texture Transformer","Texture Transformer[]"]},"description":"Texture transformers applied on this texture","required":false,"fallback":null}]},{"namespace":"palladium","path":"entity","name":"Entity Texture","description":"Creates a dynamic texture based on variables and transformers.","fields":[]},{"namespace":"palladium","path":"eye_selection","name":"Eye Selection Texture","description":"Creates a texture based the eye selection of the player.","fields":[{"key":"color","type":"Color","description":"The color that will be used","required":false,"fallback":null}]}]